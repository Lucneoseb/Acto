# Cloudflare Pages / Workers Static Assets — HTTP headers config.
#
# Direct translation of netlify.toml so the site behaves identically on
# Cloudflare. Critical: the Permissions-Policy line must allow camera +
# microphone or the in-app video recorder will fail in production.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Logo + other static assets — long-lived immutable cache (filenames don't
# change, so we can cache aggressively). Bumping the ?v= query string busts
# the cache when the file content actually changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# i18n + bundled data must always revalidate so a deploy reaches users
# instantly.
/data/*
  Cache-Control: public, no-cache

# Same logic for JS modules: push a fix, all users see it on next page load.
/js/*
  Cache-Control: public, no-cache

# HTML must always revalidate.
/*.html
  Cache-Control: public, no-cache
