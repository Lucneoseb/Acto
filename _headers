# Cloudflare Pages / Workers Static Assets — HTTP headers config.
#
# Direct translation of netlify.toml so the site behaves identically on
# Cloudflare. Critical: the Permissions-Policy line must allow camera +
# microphone or the in-app video recorder will fail in production.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://gssotstyevehbzydzhlq.supabase.co https://*.supabase.co wss://gssotstyevehbzydzhlq.supabase.co wss://*.supabase.co; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:

# Logo + other static assets — long-lived immutable cache (filenames don't
# change, so we can cache aggressively). Bumping the ?v= query string busts
# the cache when the file content actually changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# i18n + bundled data must always revalidate so a deploy reaches users
# instantly.
/data/*
  Cache-Control: public, no-cache

# Same logic for JS modules: push a fix, all users see it on next page load.
/js/*
  Cache-Control: public, no-cache

# HTML must always revalidate.
/*.html
  Cache-Control: public, no-cache

# Adresses lisibles du Studio (reecrites vers welcome.html par _redirects) :
